---
/**
 * Decorative node-graph background for the hero. Purely presentational, so it
 * is hidden from assistive tech. Reads its colours from the CSS custom
 * properties on <html>, which means the theme toggle recolours it instantly
 * with no JS bookkeeping.
 */
---

<canvas id="hero-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const GRID = 28;
    const NODE_COUNT = 46;
    const LINK_DIST = 120;
    const SPEED = 0.22;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
    }

    let nodes: Node[] = [];
    let width = 0;
    let height = 0;
    let frame = 0;
    let running = false;
    let visible = true;

    const styles = getComputedStyle(document.documentElement);
    const token = (name: string) => styles.getPropertyValue(name).trim();

    function resize() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const nextW = Math.round(rect.width * dpr);
      const nextH = Math.round(rect.height * dpr);
      if (canvas.width === nextW && canvas.height === nextH) return;

      width = rect.width;
      height = rect.height;
      canvas.width = nextW;
      canvas.height = nextH;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      if (nodes.length === 0) {
        nodes = Array.from({ length: NODE_COUNT }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * SPEED,
          vy: (Math.random() - 0.5) * SPEED,
        }));
      } else {
        // Keep nodes inside the new box rather than regenerating the field.
        for (const n of nodes) {
          n.x = Math.min(n.x, width);
          n.y = Math.min(n.y, height);
        }
      }
    }

    function step() {
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;
      }
    }

    function draw() {
      if (!ctx) return;

      // Re-read every frame: the theme toggle changes these mid-animation.
      const grid = token('--canvas-grid');
      const nodeFill = token('--canvas-node');
      const link = token('--canvas-link');

      ctx.clearRect(0, 0, width, height);

      ctx.strokeStyle = grid;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = 0; x <= width; x += GRID) {
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, height);
      }
      for (let y = 0; y <= height; y += GRID) {
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(width, y + 0.5);
      }
      ctx.stroke();

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d = Math.hypot(dx, dy);
          if (d < LINK_DIST) {
            const alpha = (0.18 * (1 - d / LINK_DIST)).toFixed(3);
            ctx.strokeStyle = `rgba(${link},${alpha})`;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
        ctx.fillStyle = nodeFill;
        ctx.fillRect(nodes[i].x - 1, nodes[i].y - 1, 2, 2);
      }
    }

    function loop() {
      step();
      draw();
      frame = requestAnimationFrame(loop);
    }

    function start() {
      if (running || reduceMotion.matches || !visible) return;
      running = true;
      frame = requestAnimationFrame(loop);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(frame);
    }

    resize();
    draw();

    // Pause while the hero is scrolled out of view.
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) start();
        else stop();
      },
      { threshold: 0 },
    ).observe(canvas);

    /*
     * ResizeObserver rather than a window resize listener: the hero also changes
     * height when the web fonts finish loading and the 118px headline reflows.
     * A window listener misses that, leaving the backing store at its pre-font
     * size and letting CSS stretch it — which smears the grid lines.
     */
    new ResizeObserver(() => {
      resize();
      if (!running) draw();
    }).observe(canvas);

    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) {
        stop();
        draw();
      } else {
        start();
      }
    });

    // A backgrounded tab should not burn frames.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    start();
  }
</script>

<style>
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.55;
    pointer-events: none;
  }
</style>
