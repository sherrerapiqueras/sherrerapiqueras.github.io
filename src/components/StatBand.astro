---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: '6', accent: '+', label: t('stats.1') },
  { value: '3', accent: '', label: t('stats.2') },
  { value: '4', accent: '', label: t('stats.3') },
];
---

<div class="stats">
  {
    stats.map((stat) => (
      <div class="cell">
        <div class="value">
          {stat.value}
          {stat.accent && <span class="accent">{stat.accent}</span>}
        </div>
        <div class="label">{stat.label}</div>
      </div>
    ))
  }
</div>

<style>
  /* Dividers are a 1px gap over a --line background, not per-cell borders. */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border-top: 1px solid var(--line);
  }

  .cell {
    background: var(--bg);
    padding: 26px 34px;
  }

  .cell:first-child {
    padding-left: var(--page-pad);
  }

  .value {
    font-size: 56px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .accent {
    color: var(--mag);
  }

  .label {
    margin-top: 8px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--dim);
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: 1fr;
    }

    .cell,
    .cell:first-child {
      padding: 20px var(--page-pad);
    }

    .value {
      font-size: 44px;
    }
  }
</style>
