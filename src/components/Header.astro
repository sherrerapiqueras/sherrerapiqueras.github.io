---
import { shared, type Lang } from '../i18n/ui';
import { localizedPath, otherLang, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
---

<header class="header">
  <span class="prompt">
    {shared.prompt}<span class="colon">:~</span>$ <span class="cmd">whoami</span>
  </span>

  <nav class="nav" aria-label={t('a11y.mainNav')}>
    {
      shared.nav.map((item) => (
        <a href={item.href}>
          <span class="num">{item.num}</span> {t(item.labelKey)}
        </a>
      ))
    }
  </nav>

  <div class="toggles">
    <button
      id="theme-toggle"
      type="button"
      class="toggle bordered"
      data-label-dark={t('theme.dark')}
      data-label-light={t('theme.light')}
      data-a11y-to-light={t('a11y.themeToggle')}
      data-a11y-to-dark={t('a11y.themeToggleToDark')}>{t('theme.dark')}</button
    >

    <a
      id="lang-toggle"
      class="toggle bordered"
      href={localizedPath(other)}
      hreflang={other}
      lang={other}
      aria-label={t('a11y.langToggle')}
      data-lang-target={other}
    >
      <span class:list={{ active: lang === 'en' }}>EN</span><span class="slash">/</span><span
        class:list={{ active: lang === 'es' }}>ES</span
      >
    </a>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  function paint(theme: string) {
    if (!button) return;
    const dark = theme === 'dark';
    button.textContent = dark
      ? (button.dataset.labelDark ?? '')
      : (button.dataset.labelLight ?? '');
    // The label names the current theme, so the accessible name must name the action.
    button.setAttribute(
      'aria-label',
      (dark ? button.dataset.a11yToLight : button.dataset.a11yToDark) ?? '',
    );
  }

  paint(root.dataset.theme ?? 'dark');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';

    // Suppress hover transitions for the duration of the swap (see global.css).
    root.setAttribute('data-theme-switching', '');
    root.dataset.theme = next;
    paint(next);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => root.removeAttribute('data-theme-switching'));
    });

    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode — the choice just will not persist */
    }
  });

  /*
   * Keep the anchor scroll offset matched to the real header.
   * Its height varies with breakpoint, pointer type (44px touch targets) and
   * whether it is sticky at all, which is four media-query combinations to
   * keep in sync by hand. Measuring is both shorter and always correct.
   */
  const header = document.querySelector<HTMLElement>('.header');
  if (header) {
    const setOffset = () => {
      const sticky = getComputedStyle(header).position === 'sticky';
      root.style.setProperty('--header-h', sticky ? `${header.offsetHeight + 8}px` : '12px');
    };
    setOffset();
    new ResizeObserver(setOffset).observe(header);
    window.addEventListener('resize', setOffset);
  }

  // Remember an explicitly chosen locale for the redirect in Base.astro.
  document.getElementById('lang-toggle')?.addEventListener('click', (event) => {
    const target = (event.currentTarget as HTMLElement).dataset.langTarget;
    try {
      if (target) localStorage.setItem('lang', target);
    } catch {
      /* ignore */
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 12px 28px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }

  .prompt {
    color: var(--dim);
    white-space: nowrap;
  }

  .colon {
    color: var(--teal);
  }

  .cmd {
    color: var(--fg);
  }

  .nav {
    display: flex;
    gap: 22px;
    color: var(--muted);
  }

  /*
   * inline-flex with an explicit gap rather than relying on the literal space
   * in the markup: the touch-target rules below turn this into a flex
   * container, and flex discards whitespace between items — which silently
   * turned "01 /index" into "01/index" on touch devices.
   */
  .nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 1ch;
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease;
  }

  .nav a:hover {
    color: var(--fg);
  }

  .nav .num {
    color: var(--mag);
  }

  .toggles {
    display: flex;
    gap: 8px;
  }

  .toggle {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 2px;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.35;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  #theme-toggle {
    /* Both labels are 6 glyphs, but the glyph widths differ; pin the width so
       the header does not shift when the theme flips. */
    min-width: 74px;
    text-align: center;
  }

  /* Margin, not literal spaces around the glyph — see the note on .nav a. */
  .slash {
    color: var(--faint);
    margin-inline: 0.5ch;
  }

  /*
   * The selected locale is emphasised and the other is dimmed.
   *
   * This was originally inverted, on the reasoning that the bright half should
   * be the thing you can click. But a two-segment EN/ES control reads as a
   * state indicator, not a link — so highlighting the target made it look like
   * the other language was already active.
   *
   * Weight as well as colour: distinguishing the selected state by colour alone
   * fails WCAG 1.4.1.
   */
  #lang-toggle .active {
    color: var(--fg);
    font-weight: 700;
  }

  #lang-toggle span:not(.active):not(.slash) {
    color: var(--dim);
    font-weight: 400;
  }

  /* Tablet: the prompt is the first thing that can go — nav and toggles are
     both functional, the prompt is flavour. */
  @media (max-width: 900px) {
    .header {
      gap: 12px;
      padding: 12px 20px;
    }

    .prompt {
      display: none;
    }

    .nav {
      gap: 16px;
    }
  }

  /*
   * Phone: nav (322px) + toggles (153px) cannot share a 375px row — that
   * combination overflowed the viewport and produced horizontal scroll. So the
   * header becomes two rows: controls on top, nav spread edge-to-edge below.
   * Both stay reachable, and nothing is hidden.
   */
  @media (max-width: 600px) {
    /*
     * Not sticky on phones. Two rows of controls with 44px touch targets comes
     * to ~105px, and pinning that to the top of an 812px screen costs 13% of
     * the viewport for the whole scroll. Letting it scroll away keeps both the
     * nav and the toggles without taxing every other screenful; theme and
     * language are set-once choices, so having them at the top is no loss.
     */
    .header {
      position: static;
      flex-wrap: wrap;
      gap: 0 12px;
      padding: 8px 20px;
    }

    .toggles {
      margin-left: auto;
    }

    .nav {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 4px;
      font-size: 11px;
    }
  }

  /* Below ~360px the four paths stop fitting even edge-to-edge. */
  @media (max-width: 360px) {
    .nav {
      font-size: 10px;
    }

    .toggle {
      letter-spacing: 0.03em;
    }

    #theme-toggle {
      min-width: 66px;
    }
  }

  /*
   * Touch targets. No negative margins here: pulling the hit area back out of
   * flow made the nav links overlap the toggles sitting directly above them on
   * the phone layout, so a tap near the row edge hit the wrong control. The
   * header is simply allowed to be taller on touch devices.
   */
  @media (pointer: coarse) {
    .nav a {
      align-items: center;
      min-height: 44px;
    }

    .toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding-block: 0;
    }
  }
</style>
