---
import ProjectCard from './ProjectCard.astro';
import { shared, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { resolveProjects } from '../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await resolveProjects();
const tracked = String(projects.length).padStart(2, '0');
---

<section id="projects" class="section projects">
  <div class="heading-row">
    <span class="num">02</span>
    <h2>{t('projects.heading')}</h2>
    <span class="rule" aria-hidden="true"></span>
    <span class="aside">registry · {tracked} {t('projects.tracked')}</span>
  </div>

  <p class="note">{t('projects.note')}</p>
  <p class="bridge">
    {t('projects.bridge')}{' '}
    <a href={shared.mandrecode} rel="me noopener">{shared.mandrecodeLabel}</a>
  </p>

  {projects.map((project) => <ProjectCard project={project} lang={lang} />)}

  {/* Delete this slot once there are two or more real projects. */}
  <div class="pending">
    <span><span class="tag">[ pending ]</span> {t('projects.pending')}</span>
    <span aria-hidden="true">—</span>
  </div>
</section>

<script>
  import { refreshAll } from '../lib/refresh-releases';

  refreshAll();
</script>

<style>
  .projects {
    padding-bottom: 20px;
  }

  .heading-row {
    margin-bottom: 8px;
  }

  .note {
    margin-bottom: 8px;
    font-size: 11.5px;
    color: var(--faint);
    text-wrap: pretty;
  }

  .bridge {
    margin-bottom: 34px;
    font-size: 11.5px;
    color: var(--faint);
    text-wrap: pretty;
  }

  .bridge a {
    color: var(--muted);
  }

  .bridge a:hover {
    text-decoration: underline;
  }

  .pending {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
    padding: 20px 24px;
    border: 1px dashed var(--line);
    font-size: 12px;
    color: var(--faint);
  }

  .pending .tag {
    color: var(--dim);
  }

  @media (max-width: 600px) {
    .note {
      margin-bottom: 24px;
    }

    .pending {
      padding: 16px 18px;
      font-size: 11.5px;
    }

    /* The trailing em-dash is decorative and only crowds a narrow row. */
    .pending span[aria-hidden] {
      display: none;
    }
  }
</style>
