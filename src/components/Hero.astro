---
import HeroCanvas from './HeroCanvas.astro';
import { shared, type Lang } from '../i18n/ui';
import { useTranslations, withBase } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const boot = [
  { state: 'ok', text: t('boot.1') },
  { state: 'ok', text: t('boot.2') },
  { state: 'ok', text: t('boot.3') },
  { state: 'open', text: t('boot.4') },
] as const;

// The CV exists in both languages; serve the one matching the page.
const cvHref = withBase(`/assets/${t('hero.cvFile')}`);
---

<section id="index" class="hero">
  <HeroCanvas />

  <div class="inner">
    <div class="boot">
      {
        boot.map((line) => (
          <div>
            <span class:list={['state', line.state]}>[ {line.state} ]</span> {line.text}
          </div>
        ))
      }
    </div>

    <h1 class="name">
      {shared.displayName[0]}<br />{shared.displayName[1]}<span class="caret" aria-hidden="true"
      ></span>
    </h1>

    <p class="role">
      <span>{shared.role}</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="remote">{shared.remote}</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="location">{shared.location}</span>
    </p>

    <p class="pitch">{t('hero.pitch')}</p>

    <div class="ctas">
      <a class="cta-primary" href="#contact">{t('hero.ctaPrimary')}</a>
      <a
        class="cta-secondary bordered"
        href={cvHref}
        download
        type="application/pdf"
        aria-label={t('hero.ctaSecondaryLabel')}>{t('hero.ctaSecondary')}</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 76px var(--page-pad) 60px;
    scroll-margin-top: var(--header-h);
  }

  .inner {
    position: relative;
  }

  /* ------------------------------------------------------------- boot --- */

  .boot {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 40px;
    font-size: 12px;
    line-height: 1.65;
    color: var(--dim);
  }

  .state.ok {
    color: var(--teal);
  }

  .state.open {
    color: var(--mag);
  }

  /* ------------------------------------------------------------- name --- */

  /* 118px is the design size and the cap. Scaling by vw below that keeps the
     name edge-to-edge at every width without a stack of breakpoints — and
     avoids the 14vw-below-900 rule this replaced, which rendered *larger*
     than 118px between 843px and 900px. */
  .name {
    font-size: clamp(38px, 15vw, 118px);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.055em;
    color: var(--fg);
    text-wrap: nowrap;
  }

  /* Sized in em so the caret tracks the name at every width: the design's
     52/88/16/-6px against a 118px name. */
  .caret {
    display: inline-block;
    width: 0.441em;
    height: 0.746em;
    margin-left: 0.136em;
    vertical-align: -0.051em;
    background: var(--mag);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
      opacity: 1;
    }
  }

  /* ------------------------------------------------------------- role --- */

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px;
    margin-top: 30px;
    font-size: 14px;
    letter-spacing: 0.16em;
    color: var(--teal);
  }

  .role .sep {
    color: var(--faint);
  }

  .role .remote {
    color: var(--fg);
    border-bottom: 2px solid var(--mag);
  }

  .role .location {
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* ------------------------------------------------------------ pitch --- */

  .pitch {
    max-width: 620px;
    margin-top: 22px;
    font-family: var(--font-prose);
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* ------------------------------------------------------------- ctas --- */

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
    font-size: 12.5px;
  }

  .cta-primary,
  .cta-secondary {
    padding: 12px 20px;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  /* --magFill, not --mag: white text sits on this. See global.css. */
  .cta-primary {
    background: var(--magFill);
    color: var(--onMag);
    font-weight: 700;
    transition: background-color 120ms ease;
  }

  .cta-primary:hover {
    background: var(--magFill-hover);
  }

  .cta-secondary {
    color: var(--fg2);
  }

  /* ------------------------------------------------------ responsive --- */

  @media (max-width: 900px) {
    .hero {
      padding-top: 52px;
      padding-bottom: 46px;
    }

    .boot {
      margin-bottom: 30px;
      font-size: 11.5px;
    }

    .role {
      gap: 10px;
      font-size: 13px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 36px;
      padding-bottom: 36px;
    }

    .boot {
      margin-bottom: 24px;
      font-size: 11px;
    }

    .role {
      gap: 8px;
      margin-top: 22px;
      font-size: 11.5px;
      letter-spacing: 0.12em;
    }

    .pitch {
      margin-top: 18px;
      font-size: 13.5px;
      line-height: 1.7;
    }

    .ctas {
      margin-top: 26px;
      gap: 10px;
    }

    /* Full-width stacked CTAs read as buttons on a phone and give a
       comfortable target without changing the type. */
    .cta-primary,
    .cta-secondary {
      flex: 1 1 100%;
      padding: 14px 18px;
      text-align: center;
    }
  }
</style>
