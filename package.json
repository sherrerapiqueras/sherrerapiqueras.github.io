{
  "name": "portfolio",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "description": "Personal portfolio for Sergio Herrera Piqueras",
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:csp": "node scripts/check-csp.mjs",
    "test:watch": "vitest",
    "test": "vitest run",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run check:csp",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "verify:all": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherrerapiqueras/sherrerapiqueras.github.io.git"
  },
  "homepage": "https://sherrerapiqueras.github.io",
  "bugs": {
    "url": "https://github.com/sherrerapiqueras/sherrerapiqueras.github.io/issues"
  },
  "author": "Sergio Herrera Piqueras"
}
